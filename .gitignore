# Machine-local credentials, MATLAB preferences, cluster jobs and render caches.
# Keep these directories on the workstation, but never include them in releases.
/.codex-tmp/
/.matlab_prefs*/
/local_cluster_jobs/
/tmp/

# All experiment outputs, models, figures and run logs are archived separately.
/results/

# The Zenodo data-package staging area is intentionally not part of the code repo.
/reproducibility_release_v1.0.0/

# Local manuscript, result and AI/debug working archive.
/_local_archive/

# Locally retained AI-generated review, release-planning and status records.
/release/
/REVISION_STATUS.md

# A presentation asset, not part of the executable research package.
/project_intro_poster.png

# The bundled CasADi distribution is kept locally but not committed to GitHub.
/MPC_DWA_Fusion/third_party/casadi-3.8.0-windows64-matlab2018b/**
!/MPC_DWA_Fusion/third_party/casadi-3.8.0-windows64-matlab2018b/README.md

# The complete manuscript workspace is kept out of the code repository.
/paper/
